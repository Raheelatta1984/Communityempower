# Local Neon connection. Prefer DATABASE_URL; Vercel Neon integration MYCOMM_DATABASE_URL is also supported.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require
DATABASE_SSL=require
PORT=3001
# Long random secret for trusted integrations and scheduled jobs (never expose to browser).
ADMIN_API_TOKEN=replace-with-a-long-random-secret
